# Variables lues à la compilation (préfixe VITE_). Aucune ne doit contenir de secret : tout ce qui commence par
# VITE_ est publié dans le code du site. La clé « publique » de Supabase l'est par conception ; c'est la sécurité
# par ligne (RLS, voir supabase/migrations) qui protège les données, pas le secret de cette clé.

# Authentification (Supabase). Sans ces deux valeurs, le site tourne en « mode aperçu » : rien n'est enregistré.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Où mène le bouton « Ouvrir l'application ». Par défaut : l'application installée sur le poste de l'utilisateur.
VITE_APP_URL=http://localhost:4000

# Adresse publique du site (pour l'image de partage des réseaux sociaux). Facultatif.
VITE_SITE_URL=https://pubresearcher.example

# Mentions de la page « Confidentialité » : qui est responsable de ce site, et comment le joindre. À renseigner.
VITE_CONTROLLER_NAME=
VITE_CONTACT_EMAIL=
