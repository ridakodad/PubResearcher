{
  "name": "pubresearcher",
  "private": true,
  "version": "1.10.0",
  "description": "PubResearcher : exploitation de dossiers patients (Word, PDF, images, DICOM) par fiche paramétrable, revue bibliographique (PubMed, Google Scholar), statistiques et export.",
  "homepage": "https://github.com/ridakodad/PubResearcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ridakodad/PubResearcher.git"
  },
  "bugs": {
    "url": "https://github.com/ridakodad/PubResearcher/issues"
  },
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "prestart": "node scripts/ensure-build.mjs",
    "start": "npm run start --workspace server",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
    "test": "npm run test --workspace server",
    "demo": "npm run demo --workspace server --",
    "backup": "npm run backup --workspace server --",
    "restore": "npm run restore --workspace server --",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
