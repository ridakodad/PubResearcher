    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "mammoth": "^1.12.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
